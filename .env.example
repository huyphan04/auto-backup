# --- PostgreSQL ---

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASS=
POSTGRES_DATABASE=
POSTGRES_SSLMODE=disable

#  which pg_dump -> paste value to PG_DUMP_BIN
PG_DUMP_BIN=/usr/local/pgsql/bin/pg_dump

# --- Local backup settings ---
BACKUP_DIR=/opt/scorex-backup/dumps
RETENTION_HOURS=168
LOG_FILE=/var/log/scorex-backup.log

# --- Azure AD / Microsoft Graph (App Registration, client credentials flow) ---
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# --- SharePoint target ---
SHAREPOINT_HOSTNAME=<tenant-comvn.sharepoint.com>
SHAREPOINT_SITE_PATH=</sites/Folder_Backup>
# DEV environment backups go to Folder_Backup
SHAREPOINT_FOLDER=<Folder_Backup>
